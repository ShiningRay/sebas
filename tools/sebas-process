#!/usr/bin/env ruby
# frozen_string_literal: true

# sebas-process：执行 docs/design/process 角色流程的确定性入口。
# 默认 dry-run；--apply 才写。详见 ruby tools/sebas-process help。

# 代码依赖 Ruby 3.2+ 的 Data.define。低版本下直接报可执行的修复指引，
# 而不是让调用方看到 uninitialized constant Data 这种内部错误。
require "rubygems"

REQUIRED_RUBY = "3.2"

if Gem::Version.new(RUBY_VERSION) < Gem::Version.new(REQUIRED_RUBY)
  warn <<~MESSAGE
    sebas-process 需要 Ruby >= #{REQUIRED_RUBY}（当前 #{RUBY_VERSION}）。
    #{RUBY_DESCRIPTION}

    修复方式（任选其一）：
      1. 使用版本管理器（会自动选中仓库根目录 .ruby-version 中的版本）：
           rbenv install && rbenv local    # rbenv
           asdf install                    # asdf
           mise settings add --local idiomatic_version_file_enable_tools ruby
           mise install                    # mise 默认不读 .ruby-version
      2. 直接用受支持解释器的绝对路径运行（ruby 若仍是系统版本，需先装好新版）：
           /path/to/ruby-3.2/bin/ruby tools/sebas-process ...
         若 ruby 已由 rbenv shim 接管，等价于：
           RBENV_VERSION=$(cat .ruby-version) ruby tools/sebas-process ...

    本命令不使用任何 gem，只需解释器版本正确。
  MESSAGE
  exit 2
end

require_relative "agents/lib/sebas_agents"

exit SebasAgents::CLI.new.run(ARGV)
