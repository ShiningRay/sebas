#!/usr/bin/env ruby
# frozen_string_literal: true

# sebas-process：执行 docs/design/process 角色流程的确定性入口。
# 默认 dry-run；--apply 才写。详见 ruby tools/sebas-process help。

# 代码依赖 Ruby 3.2+ 的 Data.define。低版本下直接报可执行的修复指引，
# 而不是让调用方看到 uninitialized constant Data 这种内部错误。
require "rubygems"

REQUIRED_RUBY = "3.2"

if Gem::Version.new(RUBY_VERSION) < Gem::Version.new(REQUIRED_RUBY)
  warn <<~MESSAGE
    sebas-process 需要 Ruby >= #{REQUIRED_RUBY}（当前 #{RUBY_VERSION}）。
    #{RUBY_DESCRIPTION}

    修复方式（任选其一）：
      1. 用版本管理器装好并切换（装完重开终端，或重新激活 shell）：
           rbenv install && rbenv rehash && rbenv local     # rbenv 读取 .ruby-version
           mise settings add --local idiomatic_version_file_enable_tools ruby
           mise install                                    # mise 默认不读 .ruby-version
           sed -i '' 's/^legacy_version_file.*/legacy_version_file = yes/' ~/.asdfrc 2>/dev/null \
             || echo 'legacy_version_file = yes' >> ~/.asdfrc
           asdf plugin add ruby && asdf install ruby 3.2.9 && asdf local ruby 3.2.9
      2. 绕开 shim，直接用受支持解释器的绝对路径运行：
           "$(rbenv root)/versions/3.2.9/bin/ruby" tools/sebas-process ...
           "$HOME/.local/share/mise/installs/ruby/3.2.9/bin/ruby" tools/sebas-process ...
           "${ASDF_DATA_DIR:-$HOME/.asdf}/installs/ruby/3.2.9/bin/ruby" tools/sebas-process ...
         之后每条 ruby 命令都要用同一路径，例如先设 RUBY=<上面的路径>。

    装好后用 ruby -v 确认已切换到 3.2 以上。本命令不使用任何 gem。
  MESSAGE
  exit 2
end

require_relative "agents/lib/sebas_agents"

exit SebasAgents::CLI.new.run(ARGV)
